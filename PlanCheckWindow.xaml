<Window x:Class="InspectionEditor.PlanCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CPP Plan Check Beta" Width="1280" Height="820" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#20242A">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="9,5"/><Setter Property="Margin" Value="2"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#8B0000" Padding="8">
            <DockPanel>
                <ComboBox x:Name="AttachmentPicker" Width="310" DockPanel.Dock="Left" SelectionChanged="AttachmentPicker_SelectionChanged"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="◀" Click="PreviousPage_Click" ToolTip="Previous page"/>
                    <TextBlock x:Name="PageText" Foreground="White" VerticalAlignment="Center" Margin="8,0"/>
                    <Button Content="▶" Click="NextPage_Click" ToolTip="Next page"/>
                    <Button Content="−" Click="ZoomOut_Click" ToolTip="Zoom out"/>
                    <TextBlock x:Name="ZoomText" Foreground="White" VerticalAlignment="Center" Width="50" TextAlignment="Center"/>
                    <Button Content="+" Click="ZoomIn_Click" ToolTip="Zoom in"/>
                </StackPanel>
                <TextBlock Text="CPP Plan Check Beta — suggestions are starting points; inspector verification is required."
                           Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,0" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#30353C" BorderBrush="#555" BorderThickness="0,0,1,0">
                <ListBox x:Name="ThumbnailList" Background="Transparent" BorderThickness="0" SelectionChanged="ThumbnailList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            </Border>
            <ScrollViewer x:Name="PlanScroll" Grid.Column="1" Background="#171A1E" HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto" PreviewMouseWheel="PlanScroll_PreviewMouseWheel"
                          PreviewMouseLeftButtonDown="PlanScroll_PreviewMouseLeftButtonDown"
                          PreviewMouseMove="PlanScroll_PreviewMouseMove"
                          PreviewMouseLeftButtonUp="PlanScroll_PreviewMouseLeftButtonUp">
                <Grid x:Name="PlanHost" HorizontalAlignment="Left" VerticalAlignment="Top" IsManipulationEnabled="True"
                      ManipulationDelta="PlanHost_ManipulationDelta" ManipulationCompleted="PlanHost_ManipulationCompleted">
                    <Image x:Name="PlanImage" Stretch="Fill" SnapsToDevicePixels="True"/>
                    <Canvas x:Name="MarkerCanvas"/>
                    <Border x:Name="LoadingOverlay" Background="#99000000" Visibility="Collapsed">
                        <TextBlock Text="Rendering…" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </ScrollViewer>
            <Border Grid.Column="2" Background="#F7F7F7" Padding="10">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Mandatory checks" FontWeight="Bold" FontSize="17" Margin="2,2,2,8"/>
                    <TextBlock DockPanel.Dock="Bottom" Text="Select a check, then tap the plan to reposition it. Use its status button to choose confirmed, deficient, or NI / not applicable."
                               TextWrapping="Wrap" Foreground="#555" Margin="2,8,2,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ChecksPanel"/></ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#ECECEC" Padding="8">
            <DockPanel>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#555" Text="Loading embedded plan…"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <CheckBox x:Name="AddAnnotatedPdfCheck" Content="Add flattened annotated PDF to INS" VerticalAlignment="Center" Margin="8,0" IsChecked="False"/>
                    <Button Content="Cancel" IsCancel="True" Click="Cancel_Click"/>
                    <Button x:Name="SaveButton" Content="Save Plan Check" IsDefault="True" IsEnabled="False" Click="Save_Click"
                            Background="#228B22" Foreground="White" FontWeight="Bold"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
