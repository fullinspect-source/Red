<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>Red</AssemblyName>
    <RootNamespace>InspectionEditor</RootNamespace>
    <Platforms>x64;x86;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>red2_dev.ico</ApplicationIcon>
    <Version>2.1.13</Version>
    <ReleaseDate>2026-08-16</ReleaseDate>
    <AssemblyTitle>RED - Inspection Editor</AssemblyTitle>
    <Company>Full Inspection Services</Company>
    <Product>RED $(Version)</Product>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ReleaseDate</_Parameter1>
      <_Parameter2>$(ReleaseDate)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="QRCoder" Version="1.4.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="UglyToad.PdfPig" Version="1.7.0-custom-5" />
    <PackageReference Include="Docnet.Core" Version="2.6.0" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\FramingDesignParserHarness\**\*.cs" />
    <Compile Remove="tests\EquipmentAirflowHarness\**\*.cs" />
  </ItemGroup>

  <!-- Never package settings.txt. Release builds use the gitignored generated key provider. -->
  <ItemGroup>
    <None Update="settings.txt">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

  <!-- Include quick comments for all team members (flatten to root) -->
  <ItemGroup>
    <Content Include="data\quick_comments.json">
      <Link>quick_comments.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- Include inspector stats for deviation indicators (flatten to root) -->
  <ItemGroup>
    <Content Include="data\inspector_stats.json">
      <Link>inspector_stats.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- Include inspection type rules/config (flatten to root) -->
  <ItemGroup>
    <Content Include="data\inspection_types.csv">
      <Link>inspection_types.csv</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!-- Embed help PDF inside the exe so all users have it automatically -->
  <ItemGroup>
    <EmbeddedResource Include="RedHelp.pdf"/>
  </ItemGroup>

  <!--
    Tesseract OCR data — required for FD plan extraction.
    To set up: create a tessdata/ folder here and place eng.traineddata in it.
    Download from: https://github.com/tesseract-ocr/tessdata_fast/raw/main/eng.traineddata
  -->
  <ItemGroup>
    <Content Include="tessdata\**\*" Condition="Exists('tessdata')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <EmbeddedResource Include="tessdata\eng.traineddata"
                      LogicalName="InspectionEditor.Resources.eng.traineddata"
                      Condition="Exists('tessdata\eng.traineddata')" />
  </ItemGroup>

  <!-- A release without the private generated provider silently disables Transcribe/Get 3. -->
  <Target Name="RequireEmbeddedAiKeyForRelease" BeforeTargets="CoreCompile" Condition="'$(Configuration)' == 'Release'">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\EmbeddedApiKeyProvider.Generated.cs')"
           Text="Release builds require the gitignored EmbeddedApiKeyProvider.Generated.cs so RED AI tools remain available." />
  </Target>

</Project>
