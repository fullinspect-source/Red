<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows + WPF since F-023: the ImageSharp-missing fallback (Services/WpfPhotoFallback.cs) is WPF. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Services/PhotoProcessingService.cs" Link="PhotoProcessingService.cs" />
    <Compile Include="../../Services/WpfPhotoFallback.cs" Link="WpfPhotoFallback.cs" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>
</Project>
