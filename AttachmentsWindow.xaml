<Window x:Class="InspectionEditor.AttachmentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ATTACHMENTS | Embedded INS PDFs" Width="940" Height="580" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner" Background="#F3F5F7">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="ATTACHMENTS" FontSize="23" FontWeight="SemiBold" Foreground="#8B0000"/>
            <TextBlock Text="PDFs embedded in this INS, not external job documents. Every page is preserved."
                       TextWrapping="Wrap" Margin="0,5,0,0"/>
            <TextBlock Text="Damaged PDFs cannot be opened. Check the damaged row and confirm Delete checked to remove it, or contact Trent to repair it."
                       TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#8B0000"/>
            <TextBlock x:Name="ModeHint" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="#555"/>
        </StackPanel>
        <DataGrid x:Name="PdfList" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                  CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column"
                  RowHeight="46" SelectionMode="Single" FontSize="14" Margin="0,0,0,12">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Select" Width="65">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="#" Binding="{Binding DisplayIndex}" Width="45" IsReadOnly="True"/>
                <DataGridTextColumn Header="Filename" Binding="{Binding Filename}" Width="2*" IsReadOnly="True"/>
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="2*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock x:Name="ResultText" Grid.Row="2" TextWrapping="Wrap" Margin="0,0,0,10" Foreground="#8B0000"/>
        <WrapPanel Grid.Row="3">
            <Button x:Name="OpenButton" Content="Open / Edit" Click="Open_Click"/>
            <Button x:Name="AddButton" Content="Add PDFs" Click="Add_Click"/>
            <Button x:Name="DeleteButton" Content="Delete checked" Click="Delete_Click"/>
            <Button x:Name="RetryButton" Content="Retry Save" Click="Retry_Click"/>
            <Button Content="Refresh" Click="Refresh_Click"/>
            <Button Content="Close" Click="Close_Click" IsCancel="True"/>
        </WrapPanel>
    </Grid>
</Window>
