<Window x:Class="InspectionEditor.OrderRequestWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Service Request"
        Width="760" Height="760"
        MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#F6F7F8"
        FontFamily="Segoe UI"
        FontSize="15">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#66737F"/>
            <Setter Property="Margin" Value="0,7,12,7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2933"/>
            <Setter Property="Margin" Value="0,7,18,7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldInput" TargetType="Control">
            <Setter Property="Margin" Value="0,4,18,4"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DialogButton" TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="#E8ECEF"/>
            <Setter Property="BorderBrush" Value="#D1D7DD"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,16,20,16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="AddressText" FontSize="22" FontWeight="SemiBold" Foreground="#1F2933" TextWrapping="Wrap"/>
            <TextBlock x:Name="SubtitleText" Foreground="#66737F" Margin="0,3,0,0" TextWrapping="Wrap"/>
            <Border x:Name="PendingJobBanner"
                    Visibility="Collapsed"
                    Background="#FDE7E1"
                    BorderBrush="#F2B8A8"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    Margin="0,10,0,0">
                <DockPanel>
                    <Button x:Name="SetJobNumberButton"
                            DockPanel.Dock="Right"
                            Content="Set Job Number"
                            Click="SetJobNumberButton_Click"
                            Style="{StaticResource DialogButton}"/>
                    <TextBlock Text="Pending Job. This request needs a job number before it can be assigned."
                               Foreground="#8A2C14" VerticalAlignment="Center" TextWrapping="Wrap"/>
                </DockPanel>
            </Border>
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" LastChildFill="False">
            <Button x:Name="DeleteButton" DockPanel.Dock="Left" Content="_Delete…" Click="DeleteButton_Click"
                    Style="{StaticResource DialogButton}" Margin="0"/>
            <Button x:Name="AddToMyListButton" DockPanel.Dock="Left" Content="Add to My _List" Click="AddToMyListButton_Click"
                    Visibility="Collapsed" Style="{StaticResource DialogButton}"/>
            <Button DockPanel.Dock="Right" Content="_Cancel" IsCancel="True" Style="{StaticResource DialogButton}"/>
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="_Save" IsDefault="True" Click="SaveButton_Click"
                    Style="{StaticResource DialogButton}"/>
            <Button x:Name="FailedButton" DockPanel.Dock="Right" Content="_Failed" Click="FailedButton_Click"
                    Visibility="Collapsed" Style="{StaticResource DialogButton}"/>
            <Button x:Name="CompletedButton" DockPanel.Dock="Right" Content="C_ompleted" Click="CompletedButton_Click"
                    Visibility="Collapsed" Style="{StaticResource DialogButton}"/>
        </DockPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Builder:" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="BuilderText" Style="{StaticResource FieldValue}"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Status:" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" x:Name="StatusText" Style="{StaticResource FieldValue}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Subdivision:" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SubdivisionText" Style="{StaticResource FieldValue}"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Lot / Block:" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="1" Grid.Column="3" x:Name="LotBlockText" Style="{StaticResource FieldValue}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Requestor:" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RequestorText" Style="{StaticResource FieldValue}"/>
                    <TextBlock Grid.Row="2" Grid.Column="2" Text="Superintendent:" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" x:Name="SuperintendentText" Style="{StaticResource FieldValue}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Requested For:" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="RequestedForText" Style="{StaticResource FieldValue}"/>
                    <TextBlock Grid.Row="3" Grid.Column="2" Text="Assigned On:" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="3" Grid.Column="3" x:Name="AssignedOnText" Style="{StaticResource FieldValue}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Completed On:" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Grid.Row="4" Grid.Column="1" x:Name="CompletedOnText" Style="{StaticResource FieldValue}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Assigned To:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Row="5" Grid.Column="1" x:Name="AssignedCombo" Style="{StaticResource FieldInput}"/>
                    <TextBlock Grid.Row="5" Grid.Column="2" Text="Reinspection:" Style="{StaticResource FieldLabel}"/>
                    <CheckBox Grid.Row="5" Grid.Column="3" x:Name="ReinspectionCheckBox" VerticalAlignment="Center"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Scheduled:" Style="{StaticResource FieldLabel}"/>
                    <!-- Wraps the time under the date when the column is narrow, so it is never clipped. -->
                    <WrapPanel Grid.Row="6" Grid.Column="1">
                        <DatePicker x:Name="ScheduledDatePicker" Style="{StaticResource FieldInput}" Margin="0,4,8,4" MinWidth="130"/>
                        <TextBox x:Name="ScheduledTimeBox" Style="{StaticResource FieldInput}" Width="96" ToolTip="Time, e.g. 9:30 AM"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="6" Grid.Column="2" Text="Attempt:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="6" Grid.Column="3" x:Name="AttemptBox" Style="{StaticResource FieldInput}" Width="70" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="PO Number:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="7" Grid.Column="1" x:Name="PurchaseOrderBox" Style="{StaticResource FieldInput}"/>
                    <TextBlock Grid.Row="7" Grid.Column="2" Text="Requisition Number:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="7" Grid.Column="3" x:Name="RequisitionBox" Style="{StaticResource FieldInput}"/>
                </Grid>

                <TextBlock Text="Requests:" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                <TextBox x:Name="SpecialRequestBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="70"
                         Background="White" BorderBrush="#D0D5DA" Padding="8,6"/>

                <TextBlock Text="History:" Style="{StaticResource FieldLabel}" Margin="0,12,0,4"/>
                <TextBox x:Name="HistoryBox" IsReadOnly="True" TextWrapping="Wrap" MinHeight="110"
                         VerticalScrollBarVisibility="Auto"
                         Background="White" BorderBrush="#D0D5DA" Padding="8,6"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
