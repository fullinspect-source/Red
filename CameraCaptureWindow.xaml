<Window x:Class="InspectionEditor.CameraCaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RED Camera"
        Width="800" Height="600" MinWidth="360" MinHeight="360"
        Background="#111111"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        PreviewKeyDown="Window_PreviewKeyDown">
    <!-- F-027: RED's own capture screen. The shutter is always visible (C6); every status is shown here, never as a popup. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Background="#1E1E1E" LastChildFill="True">
            <!-- Owner 2026-10-22: Close twice as tall (88 px). -->
            <Button x:Name="CloseCameraButton" DockPanel.Dock="Right" Content="✕ Close" FontSize="16" MinWidth="96" MinHeight="88"
                    Margin="6" Padding="12,4" Click="CloseCameraButton_Click" AutomationProperties.AutomationId="CloseCameraButton"/>
            <!-- F-027 L1 (owner 2026-10-22): every photo saved landscape, whichever way the tablet is held; on by default. -->
            <ToggleButton x:Name="LandscapeToggle" DockPanel.Dock="Right" FontSize="16" MinWidth="130" MinHeight="88" Margin="6"
                          Padding="12,4" Focusable="False" Checked="LandscapeToggle_Changed" Unchecked="LandscapeToggle_Changed"
                          AutomationProperties.AutomationId="LandscapeToggle" AutomationProperties.Name="Always save landscape photos"/>
            <StackPanel VerticalAlignment="Center" Margin="12,6">
                <!-- Wraps (up to three lines in the 88 px bar) so a narrow window still shows which item gets the photo. -->
                <TextBlock x:Name="TargetText" Foreground="White" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                           MaxHeight="69" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="CameraTargetText"/>
                <TextBlock x:Name="CameraNameText" Foreground="#A0A7AE" FontSize="12" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <Grid x:Name="PreviewArea" Grid.Row="1" Background="Black" ClipToBounds="True">
            <!-- F-027 Z4/T1: pinch, mouse wheel, tap to focus and double-tap zoom reset on the whole preview area. Only this
                 surface takes the touch manipulation, so the buttons on top (shutter, switch, readout, failure panel) keep
                 ordinary taps. -->
            <Border x:Name="PreviewSurface" Background="Transparent" IsManipulationEnabled="True"
                    ManipulationStarting="PreviewSurface_ManipulationStarting" ManipulationDelta="PreviewSurface_ManipulationDelta"
                    ManipulationCompleted="PreviewSurface_ManipulationCompleted" MouseWheel="PreviewSurface_MouseWheel"
                    MouseLeftButtonDown="PreviewSurface_MouseLeftButtonDown" TouchDown="PreviewSurface_TouchDown"
                    TouchUp="PreviewSurface_TouchUp" AutomationProperties.AutomationId="CameraPreviewSurface">
                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="LowQuality">
                    <Image.LayoutTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="PreviewMirror" ScaleX="1"/>
                            <RotateTransform x:Name="PreviewRotation" Angle="0"/>
                        </TransformGroup>
                    </Image.LayoutTransform>
                </Image>
            </Border>
            <Border x:Name="FlashOverlay" Background="White" Opacity="0" IsHitTestVisible="False"/>

            <!-- F-027 L1: with landscape photos on and the picture shown upright, the parts the photo will not keep are
                 shaded and the kept landscape band is outlined. -->
            <Canvas x:Name="LandscapeGuide" IsHitTestVisible="False" Visibility="Collapsed">
                <Rectangle x:Name="GuideTop" Fill="#A6000000"/>
                <Rectangle x:Name="GuideBottom" Fill="#A6000000"/>
                <Rectangle x:Name="GuideLeft" Fill="#A6000000"/>
                <Rectangle x:Name="GuideRight" Fill="#A6000000"/>
                <Rectangle x:Name="GuideFrame" Stroke="#CCFFFFFF" StrokeThickness="1.5" StrokeDashArray="6 4"/>
            </Canvas>

            <!-- F-027 T1: the mark at a tap, shown briefly while the camera focuses and exposes there. -->
            <Canvas x:Name="FocusLayer" IsHitTestVisible="False">
                <Grid x:Name="FocusMark" Width="76" Height="76" Opacity="0" AutomationProperties.AutomationId="FocusMark">
                    <Ellipse Stroke="#99000000" StrokeThickness="5"/>
                    <Ellipse Stroke="White" StrokeThickness="2"/>
                    <Line X1="38" Y1="0" X2="38" Y2="14" Stroke="White" StrokeThickness="2"/>
                    <Line X1="38" Y1="62" X2="38" Y2="76" Stroke="White" StrokeThickness="2"/>
                    <Line X1="0" Y1="38" X2="14" Y2="38" Stroke="White" StrokeThickness="2"/>
                    <Line X1="62" Y1="38" X2="76" Y2="38" Stroke="White" StrokeThickness="2"/>
                </Grid>
            </Canvas>

            <!-- F-027 Z5: the zoom while zoomed in; a tap goes back to 1x. -->
            <Button x:Name="ZoomReadoutButton" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"
                    MinWidth="72" MinHeight="44" Padding="14,4" Focusable="False" Cursor="Hand" Visibility="Collapsed"
                    Click="ZoomReadoutButton_Click" AutomationProperties.AutomationId="ZoomReadoutButton"
                    AutomationProperties.Name="Zoom. Tap for 1x">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="#B0000000" BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="White"
                                              TextElement.FontSize="17" TextElement.FontWeight="SemiBold"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#E0303030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Border x:Name="StatusOverlay" Background="#B0000000" CornerRadius="8" Padding="22,14" Margin="16,0,120,0"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="StatusText" Foreground="White" FontSize="22" TextAlignment="Center" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="CameraStatusText"/>
            </Border>

            <Border x:Name="FailurePanel" Background="#F2202020" Visibility="Collapsed" Padding="24">
                <Border.Resources>
                    <!-- Button text wraps, so a narrow window (360 px) never cuts a button off. -->
                    <Style TargetType="Button">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"/>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <!-- The right margin keeps the buttons clear of the shutter on the right edge. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" VerticalAlignment="Center" Margin="0,0,104,0">
                    <StackPanel MaxWidth="560">
                        <TextBlock x:Name="FailureTitleText" Foreground="White" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                                   Margin="0,0,0,10" AutomationProperties.AutomationId="CameraFailureTitle"/>
                        <TextBlock x:Name="FailureDetailText" Foreground="#D0D5DA" FontSize="15" TextWrapping="Wrap" Margin="0,0,0,16"/>
                        <WrapPanel>
                            <Button x:Name="TryAgainButton" Content="Try again" FontSize="16" MinHeight="48" MinWidth="130" Margin="0,0,10,10"
                                    Padding="14,4" Click="TryAgainButton_Click" AutomationProperties.AutomationId="TryAgainButton"/>
                            <Button x:Name="UseWindowsCameraButton" Content="Use Windows Camera app" FontSize="16" MinHeight="48" Margin="0,0,10,10"
                                    Padding="14,4" Click="UseWindowsCameraButton_Click" AutomationProperties.AutomationId="UseWindowsCameraButton"/>
                            <Button x:Name="ResetCameraButton" Content="Reset camera…" FontSize="16" MinHeight="48" Margin="0,0,10,10"
                                    Padding="14,4" Click="ResetCameraButton_Click" AutomationProperties.AutomationId="ResetCameraButton"/>
                            <Button x:Name="PrivacySettingsButton" Content="Open camera privacy settings" FontSize="16" MinHeight="48"
                                    Margin="0,0,10,10" Padding="14,4" Click="PrivacySettingsButton_Click" Visibility="Collapsed"
                                    AutomationProperties.AutomationId="PrivacySettingsButton"/>
                            <Button Content="Close" FontSize="16" MinHeight="48" MinWidth="100" Margin="0,0,10,10" Padding="14,4"
                                    Click="CloseCameraButton_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="NoteBorder" Background="#E0333333" CornerRadius="6" Padding="14,8" Margin="12"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="NoteText" Foreground="White" FontSize="15" TextWrapping="Wrap" TextAlignment="Center"
                           AutomationProperties.AutomationId="CameraNoteText"/>
            </Border>
            <TextBlock x:Name="DevHintText" Foreground="#80FFFFFF" FontSize="11" Margin="8" HorizontalAlignment="Left"
                       VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False"
                       Text="Dev: Ctrl+Shift+F5 suspend/resume · F6 display off/on · F7 lock/unlock · F8 stall · F9 held upright"/>

            <!-- F-027 C11: switch camera, on the right edge just above the shutter, never over it. -->
            <Button x:Name="SwitchCameraButton" Panel.ZIndex="100" Width="56" Height="56" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Margin="0,0,32,176" Click="SwitchCameraButton_Click" Visibility="Collapsed"
                    Focusable="False" Cursor="Hand" AutomationProperties.AutomationId="SwitchCameraButton"
                    AutomationProperties.Name="Switch camera">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Round" Background="#B0000000" BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="28">
                            <TextBlock Text="🔄" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Round" Property="Background" Value="#E0303030"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- F-027 C6 (owner 2026-10-22): the shutter overlays the middle of the right edge, like the Windows Camera app,
                 within thumb reach on a tablet; above every overlay, never hidden or disabled. -->
            <Button x:Name="ShutterButton" Panel.ZIndex="100" Width="88" Height="88" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Margin="0,0,16,0" Click="ShutterButton_Click" Focusable="False" Cursor="Hand"
                    AutomationProperties.AutomationId="ShutterButton" AutomationProperties.Name="Take photo">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="#40000000"/>
                            <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="5" Fill="Transparent"/>
                            <Ellipse x:Name="Core" Margin="10" Fill="White"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Core" Property="Fill" Value="#FFD0D0D0"/>
                                <Setter TargetName="Core" Property="Margin" Value="14"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <Grid Grid.Row="2" Background="#1E1E1E" MinHeight="88">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,8">
                <Border Width="72" Height="72" Background="#2A2A2A" CornerRadius="4" ClipToBounds="True">
                    <Image x:Name="LastPhotoImage" Stretch="UniformToFill"/>
                </Border>
                <TextBlock x:Name="CountText" Foreground="White" FontSize="15" VerticalAlignment="Center" Margin="10,0,0,0"
                           AutomationProperties.AutomationId="CameraCountText"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
